# LeakGuard AI Environment Configuration

# FastAPI Backend Settings
DATABASE_URL=sqlite:///./leakguard.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leakguard

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security Gateway Sensitivity Defaults
SECURITY_SENSITIVITY=75
STRICT_MODE=false

# Optional LLM Integration for Semantic Evaluation
OPENAI_API_KEY=
LLM_ENFORCE_SEMANTIC=false

# Frontend API Endpoint Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_USE_MOCK_DATA=false
